# 公网只读镜像的反代配置
#
# 域名用的是 sslip.io：把 IP 里的点换成横杠就是域名，能正常签 Let's Encrypt 证书，
# 不需要买域名、也不用配 DNS。换服务器时记得把域名一起改掉。
#
# 密码哈希这样生成（明文不进命令行参数以外的地方，也不落盘）：
#   caddy hash-password --plaintext '你的密码'        # 宿主安装
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'   # 容器
#
# 注意：**不要**配 email。填 example.com 之类的占位邮箱会被 Let's Encrypt 拒绝
# （invalidContact: contact email has forbidden domain），不填不影响签发。
120-27-128-11.sslip.io {
	encode zstd gzip

	# 公网入口要密码：应用本身没有登录，靠这一层挡住
	basic_auth {
		kevin $2a$14$REPLACE_WITH_GENERATED_HASH
	}

	# 上游：宿主安装是 127.0.0.1:8788，容器里是 app:8787（compose 用环境变量传进来）
	# SSE 必须关掉缓冲：否则「下载百分比 / 转写剩余时间」会攒在代理里，进度条不动
	reverse_proxy {$PA_APP_UPSTREAM:127.0.0.1:8788} {
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	# 音频文件是 40MB 量级，允许断点续传（Range 由应用处理）
	request_body {
		max_size 1GB
	}

	log {
		output file {$PA_LOG_DIR:/var/lib/caddy}/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
