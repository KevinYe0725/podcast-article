[Unit]
Description=Podcast Article cloud transcription workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=podcast
Group=podcast
WorkingDirectory=/srv/podcast-article
EnvironmentFile=/etc/podcast-article/server.env
Environment=PA_READONLY=0
Environment=PA_ASR_BACKEND=cloud
Environment=PA_ASR_URL_EXPIRES=86400
Environment=PA_DATA_ROOT=/srv/podcast-article/data
Environment=PA_COOKIE_SECURE=1
Environment=PA_COOKIE_DOMAIN=podcast.squareconf.cn
Environment=PA_PUBLIC_BASE_URL=https://podcast.squareconf.cn
Environment=PA_TRUSTED_PROXY=1
Environment=PA_SCHEDULER=0
# The Portfolio Hub Caddy container reaches the host through Docker's bridge gateway.
# This address is not the public interface; Caddy remains the only public entrypoint.
ExecStart=/srv/podcast-article/.venv/bin/python webapp.py --host 172.17.0.1 --port 8788
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/podcast-article/data

[Install]
WantedBy=multi-user.target
